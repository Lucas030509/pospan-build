{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "POSPAN",
  "version": "0.1.0",
  "identifier": "com.simonsanchez.pospan",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "POSPAN - Caja",
        "width": 1200,
        "height": 800
      },
      {
        "label": "customer-display",
        "title": "Visor de Cliente",
        "width": 800,
        "height": 600,
        "fullscreen": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:pospan.db"
      ]
    }
  }
}